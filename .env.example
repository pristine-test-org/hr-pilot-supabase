# Printed by `supabase start` (or `supabase status`). For a hosted project, use the Project URL and
# the publishable key from the dashboard (Project Settings > API Keys). Both are safe in the browser:
# row level security decides what each signed-in user can read or change.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
